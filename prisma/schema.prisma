generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String          @id @default(cuid())
  name                 String
  email                String          @unique
  password             String
  image                String?
  theme                String          @default("light")
  dashboardCards       String?
  emailVerified        DateTime?
  verificationCode     String?
  verificationExpires  DateTime?
  verificationSentAt   DateTime?
  resetCode            String?
  resetExpires         DateTime?
  resetSentAt          DateTime?
  deleteCode           String?
  deleteCodeExpires    DateTime?
  deleteCodeSentAt     DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  transactions         Transaction[]
  accounts             Account[]
  categories           Category[]
  budgets              Budget[]
  recurringRules       RecurringRule[]
  goals                SavingsGoal[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
}

model Account {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           String          @default("CARTEIRA")
  color          String          @default("#10b981")
  initialBalance Int             @default(0)
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transactions   Transaction[]
  recurringRules RecurringRule[] @relation("RecurringFromAccount")
  recurringIncoming RecurringRule[] @relation("RecurringToAccount")
  goals          SavingsGoal[]
  goalsAutoContribute SavingsGoal[] @relation("GoalAutoContribute")

  @@index([userId])
}

model Category {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           String
  color          String          @default("#78716c")
  icon           String          @default("tag")
  position       Int             @default(0)
  createdAt      DateTime        @default(now())
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Budget {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amountCents Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, categoryId])
}

model RecurringRule {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  description      String
  amountCents      Int
  kind             String        @default("TRANSACTION")
  type             String
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountId        String
  account          Account       @relation("RecurringFromAccount", fields: [accountId], references: [id], onDelete: Cascade)
  toAccountId      String?
  toAccount        Account?      @relation("RecurringToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  dayOfMonth       Int
  active           Boolean       @default(true)
  notifyDaysBefore     Int           @default(3)
  lastNotifiedAt       DateTime?
  lastMaterializedMonth String?
  position             Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[]

  @@index([userId])
}

model Transaction {
  id              String         @id @default(cuid())
  transactionType String
  description     String
  amount          Int
  date            DateTime
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String?
  account         Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transferGroupId String?
  recurringId     String?
  recurringRule   RecurringRule? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  occurrenceMonth String?
  installmentGroupId String?
  installmentCurrent Int?
  installmentTotal   Int?

  @@index([userId, date])
  @@index([userId, accountId])
  @@index([userId, categoryId])
  @@index([installmentGroupId])
}

model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  icon          String?
  targetAmount  Int
  currentAmount Int       @default(0)
  accountId     String?
  account       Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  targetDate    DateTime?
  autoContributeAmount      Int?
  autoContributeDayOfMonth  Int?
  autoContributeAccountId   String?
  autoContributeAccount     Account?   @relation("GoalAutoContribute", fields: [autoContributeAccountId], references: [id], onDelete: SetNull)
  autoLastMaterializedMonth String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint     String
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([userId])
}

DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/gestor"
AUTH_SECRET="<gere-um-secret-com: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\">"
AUTH_TRUST_HOST="true"
# Envio de e-mails — use SMTP (Gmail) OU Resend. SMTP tem prioridade.
EMAIL_FROM="Gestor Financeiro <seuemail@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="seuemail@gmail.com"
SMTP_PASS="<senha-de-app-do-gmail>"
RESEND_API_KEY="<sua-api-key-do-resend>"
# Autentica o cron do relatório mensal (a Vercel envia no header Authorization)
CRON_SECRET="<gere-um-secret-aleatorio>"
SENTRY_DSN="<seu-dsn-do-sentry>"
SENTRY_ORG="<slug-da-organizacao-sentry>"
SENTRY_PROJECT="<slug-do-projeto-sentry>"
SENTRY_AUTH_TOKEN="<token-de-auth-sentry>"
